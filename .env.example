# Configuración de Firebase Admin SDK
# Ruta al archivo JSON de credenciales de Firebase
GOOGLE_APPLICATION_CREDENTIALS=ruta/a/tu/firebase-credentials.json

# Clave de encriptación para las API Keys de Intervals.icu
# Genera una clave ejecutando: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=tu_clave_de_encriptacion_aqui
